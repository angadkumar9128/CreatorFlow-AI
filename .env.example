# ─────────────────────────────────────────────────────────────
# TEXT (captions, hashtags, scripts) — you need AT LEAST ONE.
# They are tried top to bottom; the first one with a key wins.
# ─────────────────────────────────────────────────────────────

# Groq — recommended. Free, no credit card, very fast.
# Key: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini — free tier via AI Studio.
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter — free models (any id ending in :free).
# Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cerebras — free developer tier.
# Key: https://cloud.cerebras.ai
CEREBRAS_API_KEY=


# ─────────────────────────────────────────────────────────────
# IMAGES — all optional. With no keys at all the app falls back
# to Pollinations, which needs no account but is slower and
# rate-limited at busy times.
# ─────────────────────────────────────────────────────────────

# Cloudflare Workers AI — best free option. ~230 FLUX images/day.
# Dashboard: https://dash.cloudflare.com  →  AI  →  Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Together AI — FLUX.1 schnell free endpoint.
# Key: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# Pollinations — optional token raises the rate limit.
# https://auth.pollinations.ai
POLLINATIONS_TOKEN=


# ─────────────────────────────────────────────────────────────
# Branding burned into every reel. Optional.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_HANDLE=@yourhandle
